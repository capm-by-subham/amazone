VIEW DeliveryAssignment_WARE_HOUSE_DRIVER AS

SELECT W.NAME as WareHouse_Name , D.NAME AS DRIVER_NAME


FROM DeliveryAssignment_WareHouse AS W
LEFT OUTER JOIN DeliveryAssignment_Vehicle AS V 
ON V.assignWareHouse_ID = W.ID
LEFT OUTER JOIN DeliveryAssignment_Driver AS D
ON D.assignedVehicle_ID = V.ID

WHERE D.STATUS = 'A';
